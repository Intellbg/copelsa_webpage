---
export interface Props {
    imagen: string;
    title: string;
}
const { imagen,title } = Astro.props;
import cover1 from "../images/cover1.jpg";
import cover2 from "../images/cover2.jpg";
import cover3 from "../images/cover3.jpg";
import cover4 from "../images/cover4.jpg";

const covers = {
    c1: cover1.src,
    c2: cover2.src,
    c3: cover3.src,
    c4: cover4.src,
};

---

<section id={imagen} class="hero is-large" style={`--cover-image: url(${covers[imagen]});`}>
    <h1 class="title-text parallax-title">{title}</h1>
</section>

<style is:global>
    .hero{
        width: 100%;
        position: relative;
    }

    .parallax-title{
        background-color:#00000080;
        position: absolute;
        width: 100%;
        bottom: 0;
        color: white;
        margin: 0%;
        text-align: center;
        padding: 1rem;
        font-size: 2rem;
    }

    #c1 {
        background-image: var(--cover-image);
        width: 100%;
        height: 400px;
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    #c2 {
        background-image: var(--cover-image);
        width: 100%;
        height: 400px;
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }
    #c3 {
        background-image: var(--cover-image);
        width: 100%;
        height: 400px;
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }
    #c4 {
        background-image: var(--cover-image);
        width: 100%;
        height: 400px;
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

</style>
